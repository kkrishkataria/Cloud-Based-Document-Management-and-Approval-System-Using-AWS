# Set APP_MODE=aws after creating the AWS resources listed in README.md.
APP_MODE=local
PORT=3000

# AWS mode only
AWS_REGION=ap-south-1
S3_BUCKET=your-private-document-bucket
DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/document_approval
SES_FROM_EMAIL=verified-sender@example.com
